  "bugs": { "url": "https://github.com/ghazalialshafi/nimaid/issues" },
  "type": "module",
  "main": "./nimaid.mjs",
  "module": "./nimaid.mjs",
  "types": "./index.d.ts",
  "exports": { ".": { "types": "./index.d.ts", "default": "./nimaid.mjs" }, "./nimaid.wasm": "./nimaid.wasm" },
  "files": ["nimaid.mjs", "nimaid.wasm", "index.d.ts", "demo.html", "README.md", "LICENSE", "THIRD_PARTY.md"],
